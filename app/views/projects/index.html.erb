<% content_for :title, "Projects" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <section class="flex flex-col gap-10">
    <div class="f-row justify-between">
      <h1 class="h1">Projects</h1>
      <%= link_to new_project_path, class: "add-btn" do %>
        <i class="fa-solid fa-plus text-body"></i>
        New project
      <% end %>
      <%# <button command="show-modal" commandfor="my-dialog">New</button> %>
    </div>

    <article class="card f-row justify-between bg-white border-gray-400">
      <p>Progress</p>
      <ul class="f-row gap-3 text-xs">
        <li>
          Open
        </li>
        <li>
          Paused
        </li>
        <li>
          Closed
        </li>
      </ul>
    </article>
  </section>

  <%# <dialog id="my-dialog">
    <p>Hello</p>
    <button commandfor="my-dialog" command="close">Close</button>
  </dialog> %>

  <section id="projects" class="my-10">
    <% if @projects.any? %>
      <% @projects.each do |project| %>
        <div class="flex flex-col justify-between pb-5 sm:pb-0">
          <%= render project %>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No projects found.</p>
    <% end %>
  </section>
</div>
