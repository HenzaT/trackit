<div id="<%= dom_id project %>" class="w-full sm:w-auto my-5 space-y-5">
  <div class="flex justify-between">
    <h2><%= project.name %></h2>
    <p><%= project.status.titleize %></p>
  </div>
  <% if project.notes %>
    <div>
      <strong class="block font-medium mb-1">Notes:</strong>
      <%= project.notes %>
    </div>
  <% end %>
</div>
