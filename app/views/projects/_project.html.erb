<article id="<%= dom_id project %>" class="card flex flex-col gap-5 bg-white border-gray-400">
  <div class="f-row justify-between">
    <div class="f-row gap-3">
      <i class="fa-solid fa-music bg-accent-light text-accent text-xl p-3 rounded-xl"></i>
      <h3 class="text-2xl font-medium"><%= project.name %></h3>
    </div>
    <span class="pill-btn <%= status_classes_pill(project) %>">
      <i class="fa-solid <%= pill_icon(project) %>"></i>
      <%= project.status.titleize %>
    </span>
  </div>
  <div class="f-row justify-between border-t border-gray-400 pt-5">
    <%= link_to project do %>
      Show project
    <% end %>
    <div class="f-row gap-4">
      <%= link_to edit_project_path(project) do %>
        <span class="flex flex-row gap-2 items-center">
          <i class="fa-solid fa-pencil"></i>
          Edit
        </span>
      <% end %>
      <%= button_to project, method: :delete, data: { turbo_confirm: "Are you sure?" } do %>
        <span class="flex flex-row gap-2 items-center">
          <i class="fa-solid fa-trash-can"></i>
          Delete...
        </span>
      <% end %>
    </div>
  </div>
</article>
